# Microsoft Entra app registration (portal.azure.com)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Upstash Redis (upstash.com -> create database -> "REST API" tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Where to redirect after successful login (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Comma-separated allowlist of authorized owner emails (matched against
# Graph /me mail + userPrincipalName, case-insensitive). Anyone else who
# completes OAuth will get a 403 without their refresh token being saved.
ALLOWED_OWNER_EMAILS=contact@ncpbuild.com
